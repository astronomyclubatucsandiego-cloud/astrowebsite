---
/** Dark Sites: the places the club goes to get away from city lights. About the places,
 *  not dates, so it doesn't go stale. Facts are sourced (SDAA, CA State Parks, our past
 *  trips); anything the board hasn't confirmed stays off the page. */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import { CLUB, url } from '../config';
import { photosFor } from '../lib/gallery';
import banner from '../assets/gallery/palomar/05-the-group-under-the-200-inch-Hale-Telescope.jpg';

const SITES = [
  {
    id: 'tierra-del-sol',
    name: 'Tierra Del Sol',
    gallery: 'tds',
    intro:
      "The San Diego Astronomy Association's dark-sky observing site in east San Diego County, at 3,710 feet. " +
      'We have gone out with SDAA for overnight stargazing, looking through small and big telescopes and ' +
      'seeing a multitude of stars with just the naked eye.',
    facts: [
      ['Run by', 'The San Diego Astronomy Association (SDAA)'],
      ['Good for', 'Overnight stargazing through telescopes, far from city light'],
    ],
    /* SDAA's two pages (the site, its weather) were removed on Oct 25, 2026 because sdaa.org was hacked
       (hidden spam links injected on every page). Put them back once it's fixed:
       https://sdaa.org/tierra-del-sol-dark-sky-observing-site/ and https://sdaa.org/tierra-del-sol-weather-conditions/ */
    links: [] as { label: string; href: string }[],
  },
  {
    id: 'anza-borrego',
    name: 'Anza-Borrego',
    gallery: 'anza',
    intro:
      'Our annual weekend trip to Anza-Borrego Desert State Park, an International Dark Sky Park since 2018. ' +
      'We hike through the desert, camp under the stars, play card games, learn how to build a campfire, ' +
      'and look at the cosmos through our telescopes.',
    facts: [
      ['How often', 'Once a year, over a weekend'],
      ['Spots', 'Limited, usually about 25, so watch Discord and Instagram for the announcement'],
    ],
    links: [
      { label: 'Anza-Borrego Desert State Park', href: 'https://www.parks.ca.gov/?page_id=638' },
      { label: 'Dark Sky Park announcement (CA State Parks)', href: 'https://www.parks.ca.gov/NewsRelease/783' },
    ],
  },
  {
    id: 'palomar',
    name: 'Palomar Observatory',
    gallery: 'palomar',
    photo: '02-club-group-photo-on-the-Hale-Telescope-steps.jpg',
    /* One dark band per page, as a highlight (see CLAUDE.md). */
    dark: true,
    intro:
      'Not a place we set up our own telescopes. We visit the observatory on Palomar Mountain and tour the ' +
      '200-inch Hale Telescope, dedicated in 1948.',
    facts: [
      ['Highlight', 'Standing under the 200-inch Hale Telescope'],
    ],
    links: [
      { label: 'Visiting Palomar Observatory', href: 'https://sites.astro.caltech.edu/palomar/visitor/' },
    ],
  },
].map((site) => {
  const photos = photosFor(site.gallery);
  return { ...site, photos, picture: photos.find((p) => p.file === site.photo) ?? photos[0] };
});
---

<Base title="Dark Sites" description="Where the Astronomy Club at UC San Diego goes to stargaze away from city lights: Tierra Del Sol, Anza-Borrego and Palomar Observatory.">
  <Banner title="Dark Sites" image={banner} position="center 30%" short />

  <section class="band">
    <div class="wrap prose center">
      <p>
        City lights wash out most of the night sky, so we head out to darker places where the Milky Way is easy
        to see. Here's where we go, and how to come with us.
      </p>
    </div>
  </section>

  {SITES.map((site) => (
    <section id={site.id} class:list={['band', { 'band--dark': 'dark' in site && site.dark }]}>
      <div class="wrap">
        <h2 class="rule-title">{site.name}</h2>
        <div class:list={['split', { 'split--no-media': !site.picture }]}>
          {site.picture && (
            <a class="split__media" href={url(`/gallery/${site.gallery}/`)}>
              <Image src={site.picture.image} alt={site.picture.alt} widths={[500, 1000]} sizes="(max-width: 760px) 90vw, 420px" />
            </a>
          )}
          <div class="split__text">
            <p>{site.intro}</p>
            <dl class="site__facts">
              {site.facts.map(([term, detail]) => (
                <div><dt>{term}</dt><dd>{detail}</dd></div>
              ))}
            </dl>
            {(site.links.length > 0 || site.photos.length > 0) && (
              <ul class="site__links">
                {site.links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}
                {site.photos.length > 0 && (
                  <li><a href={url(`/gallery/${site.gallery}/`)}>Our photos from {site.name} ({site.photos.length})</a></li>
                )}
              </ul>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="band" id="going">
    <div class="wrap">
      <h2 class="rule-title">Coming on a Trip</h2>
      <div class="trip-guide">
        <div>
          <h3>How to join a trip</h3>
          <ul>
            <li>Trips are announced on our <a href={CLUB.discord}>Discord</a> and <a href={CLUB.instagram}>Instagram</a>.</li>
            <li>Everyone is welcome. There's no form to fill out.</li>
          </ul>
        </div>
        <div>
          <h3>What to bring</h3>
          <ul>
            <li>Warm layers. Deserts and mountains get cold after dark, even after a hot day.</li>
            <li>A red flashlight, or red cellophane over a normal one.</li>
            <li>Water and snacks.</li>
            <li>A camp chair or blanket if you have one.</li>
          </ul>
        </div>
        <div>
          <h3>Dark-sky manners</h3>
          <ul>
            <li>No white lights. Your eyes take about 20 to 30 minutes to fully adjust to the dark, and one bright light resets everyone's.</li>
            <li>Turn your phone screen all the way down, or use night mode.</li>
            <li>Watch for cords and tripod legs, and ask before touching someone's telescope.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>
