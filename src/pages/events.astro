---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import EventBlock from '../components/EventBlock.astro';
import { CLUB } from '../config';
import { eventsByStatus } from '../lib/events';
import banner from '../assets/gallery/astrophotography/01-elephants-trunk-nebula.jpg';
import strip from '../assets/gallery/astrophotography/02-horsehead-nebula.jpg';

const { upcoming, regular, past } = await eventsByStatus();
/* Rows alternate charcoal / white down the whole page. */
let row = 0;
---

<Base title="Events" description="Upcoming and past star parties, dark-sky trips, talks and socials from the Astronomy Club at UC San Diego.">
  <Banner title="Events" image={banner} position="center 70%" />

  <div class="team-strip" id="upcoming">
    <Image src={strip} alt="" widths={[1200, 2000]} sizes="100vw" />
    <div class="wrap"><h2>Upcoming Events</h2></div>
  </div>
  {upcoming.length > 0 ? (
    upcoming.map((e) => <EventBlock event={e} dark={row++ % 2 === 0} />)
  ) : (
    <section class="band">
      <div class="wrap prose center">
        <p>
          No upcoming events are posted right now. New events are announced first on our{' '}
          <a href={CLUB.discord}>Discord</a> and <a href={CLUB.instagram}>Instagram</a>.
        </p>
      </div>
    </section>
  )}

  {regular.length > 0 && (
    <>
      <div class="team-strip" id="regular">
        <Image src={strip} alt="" widths={[1200, 2000]} sizes="100vw" />
        <div class="wrap"><h2>Regular Events</h2></div>
      </div>
      {regular.map((e) => <EventBlock event={e} dark={row++ % 2 === 0} />)}
    </>
  )}

  {past.length > 0 && (
    <>
      <div class="team-strip" id="past">
        <Image src={strip} alt="" widths={[1200, 2000]} sizes="100vw" />
        <div class="wrap"><h2>Past Events</h2></div>
      </div>
      {past.map((e) => <EventBlock event={e} dark={row++ % 2 === 0} past />)}
    </>
  )}
</Base>
