---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import { CLUB, url } from '../../config';
import { GALLERY_SECTIONS, aboutFor, isListed, photosFor, type GallerySection } from '../../lib/gallery';
import fallbackBanner from '../../assets/gallery/astrophotography/01-elephants-trunk-nebula--connor-sandfer.jpg';

export function getStaticPaths() {
  return GALLERY_SECTIONS.map((section) => ({ params: { section: section.slug }, props: { section } }));
}

const { section } = Astro.props as { section: GallerySection };
/* Thumbnails open a large optimized copy rather than the original upload,
   which for astrophotography can run to tens of megabytes. */
const photos = await Promise.all(
  photosFor(section.slug).map(async (p) => ({
    ...p,
    full: (await getImage({ src: p.image, width: Math.min(p.image.width, 2400), format: 'webp' })).src,
  })),
);
const here = url(`/gallery/${section.slug}/`);
const about = aboutFor(section);
const banner = ('banner' in section && photos.find((p) => p.file === section.banner)) || photos[0];
---

<Base title={`Gallery - ${section.title}`} description={section.description}>
  <Banner title={section.title} image={banner?.image ?? fallbackBanner} position={'bannerPosition' in section ? section.bannerPosition : undefined} short />

  <section class="band">
    <div class="wrap">
      <ul class="subnav" aria-label="Gallery sections">
        <li><a href={url('/gallery/')}>All galleries</a></li>
        {GALLERY_SECTIONS.filter((s) => s.slug === section.slug || isListed(s)).map((s) => {
          const href = url(`/gallery/${s.slug}/`);
          return <li><a href={href} aria-current={href === here ? 'page' : undefined}>{s.title}</a></li>;
        })}
      </ul>

      {about ? (
        <div class="trip-about">
          <p class="lead">{about.intro}</p>
          <dl class="site__facts">
            {about.facts.map(([term, detail]) => (
              <div><dt>{term}</dt><dd>{detail}</dd></div>
            ))}
          </dl>
          {about.links.length > 0 && (
            <ul class="site__links">
              {about.links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}
            </ul>
          )}
          <p>Trips are announced on our <a href={CLUB.discord}>Discord</a> and <a href={CLUB.instagram}>Instagram</a>. See <a href={url('/faq/#trips')}>coming on a trip</a> for what to bring.</p>
        </div>
      ) : (
        <p class="lead">{section.description}</p>
      )}

      {photos.length > 0 ? (
        <div class="photos" data-lightbox>
          {photos.map((p) => {
            const caption = p.credit ? `${p.alt}. Photo: ${p.credit}` : p.alt;
            return (
              <figure>
                <a href={p.full} data-caption={caption}>
                  <Image src={p.image} alt={p.alt} widths={[400, 800]} sizes="(max-width: 760px) 50vw, 320px" />
                </a>
                <figcaption>
                  {p.alt}
                  {p.credit && <span class="photo-credit">Photo: {p.credit}</span>}
                </figcaption>
              </figure>
            );
          })}
        </div>
      ) : (
        <p class="empty">
          No photos here yet. Have some from a club event? Share them in our <a href={CLUB.discord}>Discord</a>.
        </p>
      )}
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img alt="" />
    <p></p>
    <button class="lb-close" type="button" aria-label="Close">×</button>
    <button class="lb-prev" type="button" aria-label="Previous photo">‹</button>
    <button class="lb-next" type="button" aria-label="Next photo">›</button>
  </dialog>
</Base>

<script>
  /* Without JS each thumbnail is a plain link to its full-size image. */
  const grid = document.querySelector<HTMLElement>('[data-lightbox]');
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  if (grid && dialog) {
    const links = [...grid.querySelectorAll<HTMLAnchorElement>('a')];
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('p')!;
    let index = 0;
    const show = (i: number) => {
      index = (i + links.length) % links.length;
      img.src = links[index].href;
      img.alt = links[index].querySelector('img')?.alt ?? '';
      caption.textContent = links[index].dataset.caption ?? '';
    };
    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  }
</script>
