---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import { url } from '../../config';
import { GALLERY_SECTIONS, photosFor } from '../../lib/gallery';
import galleryBanner from '../../assets/gallery/astrophotography/02-horsehead-nebula.jpg';

const sections = GALLERY_SECTIONS.map((s) => ({ ...s, photos: photosFor(s.slug) }));
---

<Base title="Gallery" description="Photos from Astronomy Club at UC San Diego events and trips, and astrophotography by our members.">
  <Banner title="Gallery" image={galleryBanner} position="center 60%" short />

  <section class="band">
    <div class="wrap">
      <div class="gallery-index">
        {sections.map((s) => (
          <a href={url(`/gallery/${s.slug}/`)}>
            <figure>
              {s.photos[0]
                ? <Image src={s.photos[0].image} alt="" widths={[400, 800]} sizes="(max-width: 520px) 100vw, (max-width: 860px) 50vw, 320px" />
                : <span>Photos coming soon</span>}
            </figure>
            <h2>{s.title}</h2>
            <p>{s.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
