---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import { CLUB, url } from '../../config';
import { GALLERY_SECTIONS, isListed, photosFor } from '../../lib/gallery';
import galleryBanner from '../../assets/gallery/palomar/06-the-group-on-the-dome-floor.jpg';

/* Sections with photos, and trip sections with an `about`, get a tile; other empty ones are listed
   as "coming soon" until a photo is added. */
const all = GALLERY_SECTIONS.map((s) => ({ ...s, photos: photosFor(s.slug), listed: isListed(s) }));
const sections = all.filter((s) => s.listed);
const comingSoon = all.filter((s) => !s.listed).map((s) => s.title);
const list = (items: string[]) =>
  items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`;
---

<Base title="Gallery" description="Photos from Astronomy Club at UC San Diego events and trips, and astrophotography by our members.">
  <Banner title="Gallery" image={galleryBanner} position="center 25%" />

  <section class="band">
    <div class="wrap">
      <div class="gallery-index">
        {sections.map((s) => (
          <a href={url(`/gallery/${s.slug}/`)}>
            <figure>
              {s.photos.length > 0
                ? <Image src={s.photos[0].image} alt="" widths={[400, 800]} sizes="(max-width: 520px) 100vw, (max-width: 860px) 50vw, 320px" />
                : <span class="gallery-index__nophoto">Photos coming soon</span>}
            </figure>
            <h2>{s.title}</h2>
            <p>{s.description} {s.photos.length > 0 && <span class="gallery-index__count">{s.photos.length} photo{s.photos.length === 1 ? '' : 's'}</span>}</p>
          </a>
        ))}
      </div>
      {comingSoon.length > 0 && (
        <p class="coming-soon">
          Coming soon: {list(comingSoon)}. Have photos from one of these? Share them in our
          {' '}<a href={CLUB.discord}>Discord</a>.
        </p>
      )}
    </div>
  </section>
</Base>
