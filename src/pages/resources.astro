---
/** Resources: free tools and places, each group shown as a photo (or the live Tonight panel)
 *  beside its links, like the image-beside-text rows on the old Google Site. Rows alternate
 *  sides; Astrophotography is the one dark band. Every link was opened in a browser and its
 *  description checked against the site (October 2026). */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import SkyTonight from '../components/SkyTonight.astro';
import NasaPicture from '../components/NasaPicture.astro';
import { CLUB, url } from '../config';
import campus from '../assets/gallery/general/01-member-imaging-with-the-club-dobsonian.jpg';
import horsehead from '../assets/gallery/astrophotography/02-horsehead-nebula--connor-sandfer.jpg';
import outreach from '../assets/gallery/general/03-observing-event-on-campus.jpg';

const GROUPS = [
  {
    id: 'planning',
    title: 'Planning a Night Out',
    intro: 'Three things decide a good night: clouds, light pollution and the moon. Here is how to check each one.',
    media: 'tonight',
    links: [
      { name: 'Clear Outside', url: 'https://clearoutside.com/forecast/32.88/-117.24', note: 'An hour-by-hour forecast for astronomers: low, medium and high cloud, fog and the moon. This link opens the forecast for campus.' },
      { name: 'Astrospheric', url: 'https://www.astrospheric.com/', note: 'Cloud cover, transparency and seeing forecasts. The forecast on our home page comes from here.' },
      { name: 'Light Pollution Map', url: 'https://www.lightpollutionmap.info/', note: 'See how dark the sky is anywhere in the county, and find darker spots near you.' },
    ],
  },
  {
    id: 'sky',
    title: 'Finding Your Way Around the Sky',
    intro: "Not sure what you're looking at? These show what is up tonight and where to point.",
    media: { src: campus, alt: 'A member imaging with the club Dobsonian telescope on campus', caption: 'A campus observing night.' },
    links: [
      { name: 'Stellarium Web', url: 'https://stellarium-web.org/', note: 'A free planetarium in your browser. Shows exactly what is up from where you are.' },
      { name: 'Stellarium Mobile', url: 'https://stellarium-labs.com/', note: 'The phone app from the makers of Stellarium, for iOS and Android. Handy at a dark site.' },
      { name: "NASA: What's Up", url: 'https://science.nasa.gov/skywatching/whats-up/', note: 'A short monthly video and guide to what to look for each month.' },
      { name: 'Heavens-Above', url: 'https://www.heavens-above.com/', note: 'When to see the International Space Station and other satellites pass over.' },
    ],
  },
  {
    id: 'astrophotography',
    title: 'Astrophotography',
    intro: 'Want to take pictures like the ones in our gallery? Start here.',
    dark: true,
    media: { src: horsehead, alt: 'The Horsehead Nebula', caption: 'The Horsehead Nebula, taken by our former club president Connor Sandfer.', href: '/gallery/astrophotography/' },
    links: [
      { name: 'Siril', url: 'https://siril.org/', note: 'Free software for stacking and processing deep-sky images, for Windows, Mac and Linux.' },
      { name: 'Telescopius', url: 'https://telescopius.com/', note: 'Find targets that are well placed for your night and location, and build lists for an imaging session.' },
      { name: 'AstroBin', url: 'https://www.astrobin.com/', note: 'Where astrophotographers share images along with the gear and settings they used.' },
    ],
  },
  {
    id: 'community',
    title: 'Going Further',
    intro: 'Forums, observing goals and projects for when you want more between club nights.',
    media: { src: outreach, alt: 'Students and telescopes at an observing event on campus', caption: 'An observing event on campus.' },
    links: [
      { name: 'Cloudy Nights', url: 'https://www.cloudynights.com/', note: 'Amateur astronomy forums, gear reviews by members, and classifieds for buying used equipment.' },
      { name: 'Messier Observing Program', url: 'https://www.astroleague.org/messier-observing-program/', note: 'A classic goal: find all 110 Messier objects. The Astronomical League gives a certificate when you have observed most or all of them.' },
      { name: 'Globe at Night', url: 'https://globeatnight.org/', note: 'Citizen science: count the stars you can see and add your night to a worldwide record of light pollution.' },
    ],
  },
] as const;

const isInternal = (href: string) => href.startsWith('/');
/* NASA's picture of the day is shown as its own row right after this group. Rows alternate
   sides, so groups after it shift by one to keep the zig-zag. */
const NASA_AFTER = 'astrophotography';
const nasaIndex = GROUPS.findIndex((g) => g.id === NASA_AFTER);
const flipped = (i: number) => (i > nasaIndex ? i + 1 : i) % 2 === 1;
---

<Base title="Resources" description="Free tools and places for observing and astrophotography, picked by the Astronomy Club at UC San Diego.">
  <Banner title="Resources" image={horsehead} position="center 30%" short />

  {GROUPS.map((group, i) => (
    <>
    <section id={group.id} class:list={['band', { 'band--dark': 'dark' in group && group.dark }]}>
      <div class="wrap">
        <h2 class="rule-title">{group.title}</h2>
        <div class:list={['split', { 'split--flip': flipped(i) }]}>
          {group.media === 'tonight' ? (
            <div class="split__media"><SkyTonight variant="panel" /></div>
          ) : (
            <figure class="split__media">
              {'href' in group.media ? (
                <a href={url(group.media.href)}><Image src={group.media.src} alt={group.media.alt} widths={[500, 1000]} sizes="(max-width: 760px) 90vw, 420px" /></a>
              ) : (
                <Image src={group.media.src} alt={group.media.alt} widths={[500, 1000]} sizes="(max-width: 760px) 90vw, 420px" />
              )}
              <figcaption>{group.media.caption}</figcaption>
            </figure>
          )}
          <div class="split__text">
            <p class="resources-intro">{group.intro}</p>
            <ul class="resources">
              {group.links.map((l) => (
                <li>
                  <a href={isInternal(l.url) ? url(l.url) : l.url} rel={isInternal(l.url) ? undefined : 'noopener'}>{l.name}</a>
                  <p>{l.note}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
    {group.id === NASA_AFTER && <NasaPicture />}
    </>
  ))}

  <section class="band band--tight-top">
    <div class="wrap">
      <p class="resources-note">Know a resource that should be here? Share it in our <a href={CLUB.discord}>Discord</a>.</p>
    </div>
  </section>
</Base>
