---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import { CLUB } from '../config';
import banner from '../assets/gallery/astrophotography/01-elephants-trunk-nebula--connor-sandfer.jpg';
import dobsonian from '../assets/equipment/skywatcher-dobsonian.jpg';
import camera from '../assets/equipment/player-one-uranus-c.jpg';
---

<Base title="FAQs" description="How to join the Astronomy Club at UC San Diego, who can join, what equipment we use, and how to come on a trip.">
  <Banner title="Frequently Asked Questions" image={banner} position="center 80%" short />

  <section class="band">
    <div class="wrap">
      <h2 class="rule-title">Joining the Club</h2>
      <div class="faq">
        <section class="faq__item">
          <h3>How do I get involved?</h3>
          <p>
            Simply join our <a href={CLUB.instagram}>Instagram</a> and find the Linktree in our bio. There you will find
            the link to our <a href={CLUB.discord}>Discord server</a>. Please join the Discord, as it is our primary form
            of communication about events and happenings.
          </p>
        </section>

        <section class="faq__item">
          <h3>Is there anything special I have to do to be a part of the club?</h3>
          <p>
            Nope! As long as you are a part of the Astronomy Club Discord server, you are part of the club, and
            everyone is welcome to join our events.
          </p>
        </section>

        <section class="faq__item">
          <h3>Do I need to be an undergraduate student to join?</h3>
          <p>
            No! The Astronomy Club at UC San Diego is open to all student space enthusiasts.
          </p>
        </section>

        <section class="faq__item">
          <h3>What equipment do we use?</h3>
          <p>
            We have 2 club telescopes, a telescope-mountable camera for imaging, and several sizes of eyepieces and
            other dingles and dongles. <a href="#equipment">See our equipment below.</a>
          </p>
        </section>
      </div>
    </div>
  </section>

  <section class="band band--dark" id="equipment">
    <div class="wrap">
      <h2 class="rule-title">Our Equipment</h2>
      <div class="equipment">
        <figure>
          <Image src={dobsonian} alt="The club's 8 inch Skywatcher Dobsonian telescope set up on grass" widths={[500, 1000]} sizes="(max-width: 640px) 90vw, 480px" />
          <figcaption>8" Computerized Skywatcher Dobsonian</figcaption>
        </figure>
        <figure>
          <Image src={camera} alt="The Player One Uranus-C astronomy camera" widths={[500, 700]} sizes="(max-width: 640px) 90vw, 480px" />
          <figcaption>Player-One Uranus-C</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="band" id="trips">
    <div class="wrap">
      <h2 class="rule-title">Coming on a Trip</h2>
      <div class="trip-guide">
        <div>
          <h3>How to join a trip</h3>
          <ul>
            <li>Trips are announced on our <a href={CLUB.discord}>Discord</a> and <a href={CLUB.instagram}>Instagram</a>.</li>
            <li>Everyone is welcome. There's no form to fill out.</li>
          </ul>
        </div>
        <div>
          <h3>What to bring</h3>
          <ul>
            <li>Warm layers. Deserts and mountains get cold after dark, even after a hot day.</li>
            <li>A red flashlight, or red cellophane over a normal one.</li>
            <li>Water and snacks.</li>
            <li>A camp chair or blanket if you have one.</li>
          </ul>
        </div>
        <div>
          <h3>Dark-sky manners</h3>
          <ul>
            <li>No white lights. Your eyes take about 20 to 30 minutes to fully adjust to the dark, and one bright light resets everyone's.</li>
            <li>Turn your phone screen all the way down, or use night mode.</li>
            <li>Watch for cords and tripod legs, and ask before touching someone's telescope.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap prose center">
      <h2 class="subhead">Still Have a Question?</h2>
      <p>
        Ask in our <a href={CLUB.discord}>Discord</a> or email us at <a href={`mailto:${CLUB.email}`}>{CLUB.email}</a>.
      </p>
    </div>
  </section>
</Base>
