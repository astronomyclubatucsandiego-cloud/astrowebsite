---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import { CLUB } from '../config';
import horsehead from '../assets/gallery/astrophotography/02-horsehead-nebula--connor-sandfer.jpg';

const TEAMS = ['Executive Board', 'Media Team', 'Outreach Team'] as const;
/* Only the term picked in src/config.ts; entry ids look like "2026-27/julia-zhang". */
const all = (await getCollection('board')).filter((m) => m.id.startsWith(`${CLUB.boardTerm}/`));
const teams = (
  await Promise.all(
    TEAMS.map(async (team) => ({
      team,
      members: await Promise.all(
        all
          .filter((m) => m.data.team === team)
          .sort((a, b) => a.data.order - b.data.order)
          .map(async (m) => ({ ...m.data, Bio: (await render(m)).Content })),
      ),
    })),
  )
).filter((t) => t.members.length > 0);
---

<Base title="Meet the Board" description={`The ${CLUB.boardYear} board of ${CLUB.name}.`}>
  <Banner title="Meet the Board" image={horsehead} position="center 52%" />

  <section class="band page-intro">
    <div class="wrap">
      <h2 class="subhead">Current Board Members of {CLUB.boardYear}</h2>
      <p>Click a photo to learn a little bit more about each of our board members!</p>
    </div>
  </section>

  {/* A photo grid like Columbia Blueshift's team page: photo, name and role only.
       Clicking a photo opens that person's bio (verbatim) and favorite NASA image.
       Without JS each card is a <details> that opens in place. */}
  {teams.map(({ team, members }, i) => (
    <section class:list={['band', { 'band--dark': i % 2 === 1 }]}>
      <div class="wrap">
        <h2 class="rule-title">{team}</h2>
        <div class="people">
          {members.map((m) => (
            <details class="person">
              <summary>
                <span class="person__photo">
                  {m.photo
                    ? <Image src={m.photo} alt="" widths={[300, 600]} sizes="(max-width: 760px) 45vw, 14rem" />
                    : <span class="person__nophoto">Photo coming soon</span>}
                  <span class="person__more" aria-hidden="true">About {m.name.split(' ')[0]}</span>
                </span>
                <h3>{m.name}</h3>
                <span class="person__role">{m.role}</span>
              </summary>
              <div class="person__about">
                <m.Bio />
                {m.favoriteNasa && (
                  <p class="person__nasa">
                    Favorite NASA image:{' '}
                    {m.favoriteNasa.url ? <a href={m.favoriteNasa.url}>{m.favoriteNasa.text}</a> : m.favoriteNasa.text}
                  </p>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}

  <dialog class="person-card" aria-labelledby="person-card-name">
    <button class="person-card__close" type="button" aria-label="Close">×</button>
    <div class="person-card__photo"></div>
    <div class="person-card__text">
      <h2 id="person-card-name"></h2>
      <p class="person__role"></p>
      <div class="person-card__about"></div>
    </div>
  </dialog>

  <section class="band">
    <div class="wrap">
      <div class="update-note">
        <h2>Website Update Form</h2>
        {CLUB.updateForm
          ? <p>Board members: to change your photo or bio, or to request any other update to the site, fill out the <a href={CLUB.updateForm}>website update form</a>.</p>
          : <p>Board members: to change your photo or bio, or to request any other update to the site, contact our Website Coordinator.</p>}
      </div>
    </div>
  </section>
</Base>

<script>
  /* With JS, a click on a card opens the bio in a dialog instead of expanding the card. */
  const dialog = document.querySelector<HTMLDialogElement>('.person-card');
  if (dialog) {
    const photo = dialog.querySelector('.person-card__photo')!;
    const name = dialog.querySelector('h2')!;
    const role = dialog.querySelector('.person__role')!;
    const about = dialog.querySelector('.person-card__about')!;
    document.querySelectorAll<HTMLDetailsElement>('.person').forEach((card) => {
      card.querySelector('summary')!.addEventListener('click', (e) => {
        e.preventDefault();
        const img = card.querySelector('img');
        photo.replaceChildren(...(img ? [img.cloneNode()] : []));
        dialog.classList.toggle('person-card--no-photo', !img);
        name.textContent = card.querySelector('h3')!.textContent;
        role.textContent = card.querySelector('.person__role')!.textContent;
        about.replaceChildren(...[...card.querySelector('.person__about')!.childNodes].map((n) => n.cloneNode(true)));
        dialog.showModal();
      });
    });
    dialog.querySelector('.person-card__close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }
</script>
