---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import { CLUB } from '../config';
import trunk from '../assets/gallery/astrophotography/01-elephants-trunk-nebula.jpg';
import horsehead from '../assets/gallery/astrophotography/02-horsehead-nebula.jpg';
import andromeda from '../assets/gallery/astrophotography/03-andromeda-galaxy.jpg';
import campus1 from '../assets/gallery/general/01-member-imaging-with-the-club-dobsonian.jpg';
import campus2 from '../assets/gallery/general/02-students-at-the-club-telescope-on-campus.jpg';
import campus3 from '../assets/gallery/general/03-observing-event-on-campus.jpg';

/* The "Upcoming Event!" band shows this event. Change the id to feature another. */
const FEATURED_EVENT = 'anza-borrego';
const featured = await getEntry('events', FEATURED_EVENT);
const { Content: FeaturedBody } = featured ? await render(featured) : { Content: null };

const calendar = (src: string, color: string) =>
  `https://calendar.google.com/calendar/embed?${new URLSearchParams({
    src,
    color,
    ctz: 'America/Los_Angeles',
    mode: 'MONTH',
    showPrint: '0',
    showTabs: '0',
    showTz: '0',
  })}`;
---

<Base>
  <Banner title={CLUB.name} image={trunk} position="center 40%" />

  <section class="band">
    <div class="wrap">
      <ul class="jump" aria-label="On this page">
        <li><a href="#about">About Us</a></li>
        {featured && <li><a href="#upcoming">Upcoming Event!</a></li>}
        <li><a href="#calendars">Calendars</a></li>
      </ul>
    </div>
  </section>

  <section class="band" id="about" style="padding-top:0">
    <div class="wrap">
      <h2 class="rule-title">About Us</h2>
      <p class="lead">
        The Astronomy Club at UC San Diego aims to promote interest in astronomy and astrophysics among UC San Diego
        undergraduates. Our organization focuses on the exploration of the universe and our night sky. We hope to help
        students interested in astronomy get to know each other and facilitate their access to professional faculty.
      </p>

      <div class="photo-row">
        <Image src={trunk} alt="The Elephant's Trunk Nebula" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
        <Image src={horsehead} alt="The Horsehead Nebula" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
        <Image src={andromeda} alt="The Andromeda Galaxy" sizes="(max-width: 760px) 50vw, 240px" />
        <p>Images taken by our former club president Connor Sandfer</p>
      </div>
      <div class="photo-row photo-row--caption-first">
        <p>Pictures of some observing events conducted on campus</p>
        <Image src={campus1} alt="A member imaging with the club Dobsonian telescope on campus" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
        <Image src={campus2} alt="Students lining up at the club telescope at an outdoor campus event" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
        <Image src={campus3} alt="A crowd at a campus observing event with telescopes and a live view on a laptop" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
      </div>
      <p class="center" style="margin-top:2rem"><a href="gallery/">See more in the gallery</a></p>
    </div>
  </section>

  {featured && (
    <section class="band band--dark" id="upcoming">
      <div class="wrap">
        <h2 class="rule-title">Upcoming Event!</h2>
        <div class="feature">
          <div class="feature__media">
            {featured.data.flyers[0] && (
              <Image src={featured.data.flyers[0].src} alt={featured.data.flyers[0].alt} widths={[400, 800]} sizes="(max-width: 760px) 90vw, 352px" />
            )}
          </div>
          <div>
            <h3>{featured.data.title.replace(/ Stargazing and Camping Trip$/, '')}</h3>
            {featured.data.date && <p class="date">{featured.data.date}</p>}
            {FeaturedBody && <FeaturedBody />}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="band" id="calendars">
    <div class="wrap">
      <h2 class="rule-title">Calendars</h2>
      <div class="calendars">
        <div>
          <h3>Our Events</h3>
          <iframe title="Astronomy Club events calendar" src={calendar(CLUB.calendars.club, '#9fe1e7')} loading="lazy"></iframe>
        </div>
        <div>
          <h3>Astronomy Events</h3>
          <iframe title="Moon phases and astronomy events calendar" src={calendar(CLUB.calendars.astronomy, '#b99aff')} loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>
</Base>
