---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import SkyTonight from '../components/SkyTonight.astro';
import SkyForecast from '../components/SkyForecast.astro';
import { CLUB, url } from '../config';
import trunk from '../assets/gallery/astrophotography/01-elephants-trunk-nebula--connor-sandfer.jpg';
import { existsSync } from 'node:fs';

/* Banner video: W. M. Keck Observatory's "Up Above the World So High", used with Keck's permission
   (October 2026) as a placeholder until members film a night-sky time-lapse. It turns on only when
   public/video/keck-banner-960.mp4 and -1920.mp4 exist; until then the banner is the photo. */
const KECK = 'video/keck-banner';
const bannerVideo = ['960', '1920'].every((w) => existsSync(`${process.cwd()}/public/${KECK}-${w}.mp4`))
  ? { base: KECK, credit: 'W. M. Keck Observatory', creditUrl: 'https://www.youtube.com/watch?v=FpK6_C8gkhA' }
  : undefined;
import horsehead from '../assets/gallery/astrophotography/02-horsehead-nebula--connor-sandfer.jpg';
import andromeda from '../assets/gallery/astrophotography/03-andromeda-galaxy--connor-sandfer.jpg';
import campus1 from '../assets/gallery/general/01-member-imaging-with-the-club-dobsonian.jpg';
import campus2 from '../assets/gallery/general/02-students-at-the-club-telescope-on-campus.jpg';
import campus3 from '../assets/gallery/general/03-observing-event-on-campus.jpg';

/* The public moon and astronomy events calendar (moon phases, meteor showers, eclipses).
   Month grid on wide screens; a readable list (agenda) on phones, where the grid is too cramped. */
const calendar = (mode: 'MONTH' | 'AGENDA') =>
  `https://calendar.google.com/calendar/embed?${new URLSearchParams({
    src: CLUB.calendars.astronomy,
    color: '#00629B', // UC San Diego Blue; white event text on it is 6.5:1
    ctz: 'America/Los_Angeles',
    mode,
    showPrint: '0',
    showTabs: '0',
    showTz: '0',
  })}`;
---

<Base starTrail={false}>
  <Banner title={CLUB.name} image={trunk} position="center 40%" video={bannerVideo} />
  <SkyTonight />

  <section class="band" id="about">
    <div class="wrap">
      <p class="new-here">
        <strong>New here?</strong> Join our <a href={CLUB.discord}>Discord</a> and follow
        {' '}<a href={CLUB.instagram}>{CLUB.instagramHandle}</a> on Instagram. That's where we announce star
        parties, trips and meetings.
      </p>
      <h2 class="rule-title">About Us</h2>
      <p class="lead">
        The Astronomy Club at UC San Diego aims to promote interest in astronomy and astrophysics among UC San Diego
        undergraduates. Our organization focuses on the exploration of the universe and our night sky. We hope to help
        students interested in astronomy get to know each other and facilitate their access to professional faculty.
      </p>

      <div class="photo-row">
        <Image src={trunk} alt="The Elephant's Trunk Nebula" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
        <Image src={horsehead} alt="The Horsehead Nebula" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
        <Image src={andromeda} alt="The Andromeda Galaxy" sizes="(max-width: 760px) 50vw, 240px" />
        <p>Images taken by our former club president Connor Sandfer</p>
      </div>
      <div class="photo-row photo-row--caption-first">
        <p>Pictures of some observing events conducted on campus</p>
        <Image src={campus1} alt="A member imaging with the club Dobsonian telescope on campus" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
        <Image src={campus2} alt="Students lining up at the club telescope at an outdoor campus event" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
        <Image src={campus3} alt="A crowd at a campus observing event with telescopes and a live view on a laptop" widths={[300, 600]} sizes="(max-width: 760px) 50vw, 240px" />
      </div>
      <p class="more-link"><a href={url('/gallery/')}>See more in the gallery</a></p>
    </div>
  </section>

  <section class="band" id="meetings">
    <div class="wrap">
      <h2 class="rule-title">General Body Meetings</h2>
      <div class="split split--flip split--map">
        <div class="split__media">
          <iframe class="map" title={`Map of ${CLUB.gbm.room}'s building, SERF, at UC San Diego`} src={`https://www.google.com/maps?q=${encodeURIComponent(CLUB.gbm.mapQuery)}&z=17&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="split__text">
          <p>
            <strong>One GBM each quarter</strong> (fall, winter and spring). Dates are announced on
            {' '}<a href={CLUB.discord}>Discord</a> and <a href={CLUB.instagram}>Instagram</a>.
          </p>
          <p><strong>{CLUB.gbm.room}</strong>: take the elevator to the third floor; the room is down the hall.</p>
          <address class="meeting-address">
            {CLUB.gbm.room}, UC San Diego<br />
            {CLUB.gbm.address[0]}<br />
            {CLUB.gbm.address[1]}
          </address>
          <p><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(CLUB.gbm.mapQuery)}`}>Open in Google Maps</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--dark" id="forecast">
    <div class="wrap">
      <h2 class="rule-title">Observing Forecast</h2>
      <p class="lead">
        The next few nights from Astrospheric: cloud cover, transparency (how clear the air is) and seeing
        (how steady it is). Pick a place we go.
      </p>
      <SkyForecast />
    </div>
  </section>

  <section class="band" id="calendar">
    <div class="wrap">
      <h2 class="rule-title">Astronomy Calendar</h2>
      <p class="lead">Moon phases, meteor showers, eclipses and other things worth looking up for.</p>
      <iframe class="calendar calendar--month" title="Moon phases and astronomy events calendar" src={calendar('MONTH')} loading="lazy"></iframe>
      <iframe class="calendar calendar--agenda" title="Moon phases and astronomy events, as a list" src={calendar('AGENDA')} loading="lazy"></iframe>
    </div>
  </section>
</Base>
