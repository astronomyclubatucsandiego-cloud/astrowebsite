---
/** Full-width photo banner with the page title, like the Google Site headers.
 *  Optional `video`: a short silent loop that plays over the photo once it is ready. The photo is
 *  still what loads first (it's the LCP image), and stays as the fallback without JS, with reduced
 *  motion turned on, or with Data Saver on. While it plays, the credit shows on the right in a navy
 *  line just under the banner. No pause button, by the owner's choice (Oct 2026); see CLAUDE.md. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../config';

interface Props {
  title: string;
  image: ImageMetadata;
  /** CSS object-position for the crop, e.g. "center 30%". */
  position?: string;
  short?: boolean;
  /** Files in public/: `${base}-960.mp4` (phones) and `${base}-1920.mp4` (everything wider). */
  video?: { base: string; credit: string; creditUrl: string };
}
const { title, image, position = 'center', short = false, video } = Astro.props;
---

<header class:list={['banner', { 'banner--short': short }]} data-video={video ? '' : undefined}>
  <Image src={image} alt="" widths={[800, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
  {video && (
    <video
      class="banner__video"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-src-small={url(`/${video.base}-960.mp4`)}
      data-src-large={url(`/${video.base}-1920.mp4`)}
    ></video>
  )}
  <h1>{title}</h1>
</header>
{video && (
  <p class="banner-credit" hidden><span class="wrap">Video: <a href={video.creditUrl} rel="noopener">{video.credit}</a></span></p>
)}

<script>
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (!calm && !saveData) {
    document.querySelectorAll<HTMLElement>('.banner[data-video]').forEach((banner) => {
      const video = banner.querySelector<HTMLVideoElement>('.banner__video')!;
      const credit = banner.nextElementSibling as HTMLElement;
      const wide = window.matchMedia('(min-width: 761px)').matches;

      video.src = (wide ? video.dataset.srcLarge : video.dataset.srcSmall)!;
      video.addEventListener('playing', () => {
        banner.classList.add('banner--playing');
        credit.hidden = false;
      }, { once: true });
      video.play().catch(() => {}); // Autoplay refused: the photo simply stays.

      // Don't spend battery on a banner nobody can see.
      new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) video.pause();
        else video.play().catch(() => {});
      }).observe(banner);
    });
  }
</script>
