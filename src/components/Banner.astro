---
/** Full-width photo banner with the page title, like the Google Site headers. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  image: ImageMetadata;
  /** CSS object-position for the crop, e.g. "center 30%". */
  position?: string;
  short?: boolean;
}
const { title, image, position = 'center', short = false } = Astro.props;
---

<header class:list={['banner', { 'banner--short': short }]}>
  <Image src={image} alt="" widths={[800, 1600, 2400]} sizes="100vw" loading="eager" style={`object-position:${position}`} />
  <h1>{title}</h1>
</header>
