---
/** One event on the Events page: title, date, flyer(s) and description. */
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ClubEvent } from '../lib/events';

interface Props {
  event: ClubEvent;
  dark?: boolean;
  past?: boolean;
}
const { event, dark = false, past = false } = Astro.props;
const { Content } = await render(event);
const hasBody = (event.body ?? '').trim().length > 0;
/* Each flyer links to a large copy for reading the fine print. */
const flyers = await Promise.all(
  event.data.flyers.map(async (f) => ({ ...f, full: (await getImage({ src: f.src, width: 1600, format: 'webp' })).src })),
);
---

<section id={event.id} class:list={['band', 'event', { 'band--dark': dark }]}>
  <div class="wrap">
    <h2 class="rule-title">{event.data.title}</h2>
    {event.data.date && <p class="date">{past ? `Held ${event.data.date}` : event.data.date}</p>}

    {flyers.length === 1 && hasBody ? (
      <div class="feature">
        <div class="feature__media flyers">
          <a href={flyers[0].full}><Image src={flyers[0].src} alt={flyers[0].alt} widths={[400, 800]} sizes="(max-width: 760px) 90vw, 352px" /></a>
        </div>
        <div class="event__body"><Content /></div>
      </div>
    ) : (
      <>
        {hasBody && <div class="event__body prose"><Content /></div>}
        {flyers.length > 0 && (
          <div class="flyers flyers--row">
            {flyers.map((f) => (
              <a href={f.full}><Image src={f.src} alt={f.alt} widths={[400, 800]} sizes="(max-width: 760px) 90vw, 300px" /></a>
            ))}
          </div>
        )}
      </>
    )}
  </div>
</section>
