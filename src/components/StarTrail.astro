---
/** A trail of stars that follows the mouse over the photo banners and the home "Tonight" strip:
 *  point-like stars appear along the path and fade, like stars coming out as your eyes adjust.
 *  No connecting line (it read as a scratch on the photo). The owner chose to keep a trail;
 *  this version is meant to read as real starlight, not sparkles:
 *  - stars are round points with a soft glow, never spiky shapes, and never fall or spin;
 *  - colors are blackbody star colors (Mitchell Charity, "What color are the stars?"),
 *    weighted toward white and blue-white, with yellow and orange stars rarer;
 *  - brightness is lopsided like the real sky: mostly faint stars, a few bright ones.
 *  Limits: only on those dark areas, only with a mouse, never with reduced motion turned on.
 *  One canvas per area, and the animation loop stops as soon as everything has faded. */
---

<script>
  const fineMouse = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fineMouse && !calm) {
    // Gap between stars along the path, random so they clump like real stars instead of a dotted line.
    const nextGap = () => 8 + Math.random() * 26;
    const MAX_STARS = 70;

    // Spectral class colors (Charity's blackbody table) with rough naked-eye proportions.
    const COLORS: [string, number][] = [
      ['170, 191, 255', 0.15], // B, blue-white
      ['202, 215, 255', 0.25], // A, white with a blue tint
      ['248, 247, 255', 0.3], // F, white
      ['255, 244, 234', 0.15], // G, pale yellow (like the Sun)
      ['255, 210, 161', 0.1], // K, light orange
      ['255, 204, 111', 0.05], // M, orange
    ];
    const pickColor = () => {
      let roll = Math.random();
      for (const [rgb, weight] of COLORS) if ((roll -= weight) < 0) return rgb;
      return COLORS[2][0];
    };
    // Core radius in px: about 80% faint, 15% medium, 5% bright.
    const pickRadius = () => {
      const roll = Math.random();
      if (roll < 0.8) return 0.6 + Math.random() * 0.5;
      if (roll < 0.95) return 1.1 + Math.random() * 0.5;
      return 1.7 + Math.random() * 0.6;
    };

    type Star = { x: number; y: number; t: number; life: number; r: number; rgb: string };

    const setUp = (area: HTMLElement) => {
      const canvas = document.createElement('canvas');
      canvas.className = 'startrail';
      canvas.setAttribute('aria-hidden', 'true');
      area.appendChild(canvas);
      const ctx = canvas.getContext('2d')!;
      const stars: Star[] = [];
      let last: { x: number; y: number } | null = null;
      let running = false;
      let travelled = 0;
      let gap = nextGap();

      const fit = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const { width, height } = area.getBoundingClientRect();
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const addStar = (x: number, y: number, now: number) => {
        if (stars.length >= MAX_STARS) stars.shift();
        // A little scatter either side of the path, like stars near (not on) a line.
        stars.push({
          x: x + (Math.random() - 0.5) * 18,
          y: y + (Math.random() - 0.5) * 18,
          t: now,
          life: 1300 + Math.random() * 1000,
          r: pickRadius(),
          rgb: pickColor(),
        });
      };

      const drawStar = (s: Star, now: number) => {
        const age = (now - s.t) / s.life;
        // Quick fade in (no popping), then a slow ease out.
        const alpha = age < 0.06 ? age / 0.06 : 1 - ((age - 0.06) / 0.94) ** 1.6;
        const glow = s.r * (s.r > 1.6 ? 6 : 4);
        const g = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, glow);
        g.addColorStop(0, `rgba(255, 255, 255, ${alpha})`);
        g.addColorStop(s.r / glow, `rgba(${s.rgb}, ${alpha * 0.9})`);
        g.addColorStop(Math.min(1, (s.r * 2) / glow), `rgba(${s.rgb}, ${alpha * 0.25})`);
        g.addColorStop(1, `rgba(${s.rgb}, 0)`);
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(s.x, s.y, glow, 0, Math.PI * 2);
        ctx.fill();
      };

      const frame = (now: number) => {
        for (let i = stars.length - 1; i >= 0; i--) if (now - stars[i].t > stars[i].life) stars.splice(i, 1);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.globalCompositeOperation = 'lighter'; // light adds up, like on a sensor
        for (const s of stars) drawStar(s, now);
        ctx.globalCompositeOperation = 'source-over';
        if (stars.length) requestAnimationFrame(frame);
        else running = false;
      };

      area.addEventListener('pointerenter', () => {
        fit();
        last = null;
        travelled = 0;
      });
      area.addEventListener('pointerleave', () => {
        last = null;
      });
      area.addEventListener('pointermove', (e) => {
        const box = area.getBoundingClientRect();
        const now = performance.now();
        // Coalesced events give the in-between positions of a fast flick, so stars spread evenly along it.
        const coalesced = e.getCoalescedEvents?.();
        for (const ev of coalesced?.length ? coalesced : [e]) {
          const x = ev.clientX - box.left;
          const y = ev.clientY - box.top;
          if (last) {
            const step = Math.hypot(x - last.x, y - last.y);
            travelled += step;
            while (travelled >= gap) {
              travelled -= gap;
              gap = nextGap();
              const k = step ? 1 - travelled / step : 1;
              addStar(last.x + (x - last.x) * k, last.y + (y - last.y) * k, now);
            }
          }
          last = { x, y };
        }
        if (!running && stars.length) {
          running = true;
          requestAnimationFrame(frame);
        }
      }, { passive: true });
    };

    document.querySelectorAll<HTMLElement>('.banner, .tonight--strip').forEach(setUp);
  }
</script>
